// ============================================================================

model SecurityDeposit {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenancyId          String               @map("tenancy_id") @db.Uuid
  totalCollected     Decimal              @map("total_collected") @db.Decimal(12, 2)
  deductionsTotal    Decimal              @default(0) @map("deductions_total") @db.Decimal(12, 2)
  refundedAmount     Decimal              @default(0) @map("refunded_amount") @db.Decimal(12, 2)
  isDisputed         Boolean              @default(false) @map("is_disputed")
  settlementDate     DateTime?            @map("settlement_date") @db.Date
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  tenancy            Tenancy              @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  transactions       DepositTransaction[]
  settlements        DepositSettlement[]
  disputes           DepositDispute[]

  @@index([tenancyId])
  @@map("security_deposits")
}

model DepositTransaction {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  securityDepositId String          @map("security_deposit_id") @db.Uuid
  transactionType   String          @map("transaction_type") @db.VarChar(50) // "COLLECTION", "DEDUCTION_PAINTING", "DEDUCTION_REPAIR", "REFUND"
  amount            Decimal         @db.Decimal(12, 2)
  notes             String?         @db.Text
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  securityDeposit   SecurityDeposit @relation(fields: [securityDepositId], references: [id], onDelete: Cascade)

  @@index([securityDepositId])
