// ============================================================================
// STAYWISE PLATFORM — PRODUCTION PRISMA ORM SCHEMA SPECIFICATION
// Target Database: PostgreSQL 15+ (Amazon RDS / Supabase / Neon / Self-Hosted)
// ============================================================================
// Comprehensive relational model covering all 12 operational modules & 51 entities:
// 1. Organization (organizations, organization_memberships, invitations)
// 2. Access control (roles, permissions, role_permissions, resource_access_grants)
// 3. Property structure (portfolios, properties, buildings, floors, units, rooms, beds, assets)
// 4. Occupancy (tenancies, lease_parties, occupancy_history)
// 5. Leasing (leads, applications, visits, lease_documents, renewals)
// 6. Billing (rent_schedules, invoices, invoice_lines, payments, payment_allocations)
// 7. Accounting (accounts, journal_entries, journal_lines, settlements, refunds)
// 8. Deposits (security_deposits, deposit_transactions, deposit_settlements, disputes)
// 9. Maintenance (work_orders, quotes, vendor_assignments, approvals, service_evidence)
// 10. Files (documents, document_versions, document_access_logs)
// 11. Operations (meter_readings, utility_bills, inspections, scheduled_tasks)
// 12. Platform (subscriptions, plans, webhook_events, notifications, audit_logs)
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [uuid_ossp(map: "uuid-ossp"), pgcrypto]
}

// ============================================================================
// ENUMS
// ============================================================================

enum GlobalRole {
  SUPER_ADMIN
  SUPPORT_AGENT
  PLATFORM_AUDITOR
  USER
}

enum OrgRole {
  OWNER
  CO_OWNER
  PORTFOLIO_MANAGER
  PROPERTY_MANAGER
  LEASING_AGENT
  ACCOUNTANT
  MAINTENANCE_SUPERVISOR
  CARETAKER
  FIELD_STAFF
  TENANT
  VENDOR
}

enum Permission {
  ORG_MANAGE
  ORG_BILLING_VIEW
  ORG_BILLING_MANAGE
  ORG_MEMBERS_INVITE
  ORG_MEMBERS_MANAGE
  PROPERTY_CREATE
  PROPERTY_VIEW
  PROPERTY_EDIT
  PROPERTY_DELETE
  PROPERTY_VERIFY
  UNIT_CREATE
  UNIT_VIEW
  UNIT_EDIT
  UNIT_DELETE
  LEAD_MANAGE
  APPLICATION_REVIEW
  LEASE_CREATE
  LEASE_SIGN
  LEASE_TERMINATE
  TENANT_VIEW
  INVOICE_GENERATE
  INVOICE_VIEW
  INVOICE_CANCEL
  PAYMENT_COLLECT
  PAYMENT_RECORD
  REFUND_INITIATE
  REFUND_APPROVE
  LEDGER_VIEW
  LEDGER_POST
  MAINTENANCE_CREATE
  MAINTENANCE_ASSIGN
  MAINTENANCE_APPROVE_QUOTE
  MAINTENANCE_CLOSE
  INSPECTION_CONDUCT
  UTILITY_MANAGE
  DOCUMENT_UPLOAD
  DOCUMENT_VIEW_PRIVATE
  DOCUMENT_DELETE
  DOCUMENT_AUDIT
  SUBSCRIPTION_MANAGE
  AUDIT_LOG_VIEW
}

enum PropertyType {
  RESIDENTIAL_APARTMENT
  RESIDENTIAL_FLAT
  INDEPENDENT_HOUSE
  VILLA
  DUPLEX
  STUDIO
  PG_HOSTEL
  CO_LIVING
  DORMITORY
  COMMERCIAL_OFFICE
  RETAIL_SHOP
  WAREHOUSE
  TECH_PARK
  BOUTIQUE_HOTEL
  HOLIDAY_ESTATE
  SERVICED_APARTMENT
}

enum PropertyStatus {
  ACTIVE
  VACANT
  LISTED
  UNDER_MAINTENANCE
  OCCUPIED
  PARTIALLY_OCCUPIED
  RESERVED
  ARCHIVED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  DOCS_REQUIRED
}

enum UnitStatus {
  VACANT
  OCCUPIED
  RESERVED
  MAINTENANCE
  BLOCKED
}

enum LeaseStatus {
  DRAFT
  PENDING_SIGNATURE
  ACTIVE
  UPCOMING_EXPIRY
  RENEWED
  TERMINATED
  EXPIRED
  DISPUTED
}

enum LeasePartyRole {
  PRIMARY_TENANT
  CO_TENANT
  GUARANTOR
  OCCUPANT
  CORPORATE_SIGNATORY
  LANDLORD_SIGNATORY
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
  WRITTEN_OFF
}

enum PaymentStatus {
  INITIATED
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  DISPUTED
  REVERSED
}

enum PaymentMethod {
  UPI_INTENT
  UPI_COLLECT
  CREDIT_CARD
  DEBIT_CARD
  NET_BANKING
  NACH_MANDATE
  DIRECT_BANK_TRANSFER
  CASH
  CHEQUE
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum AccountCategory {
  ASSET_CASH
  ASSET_BANK
  ASSET_RECEIVABLE_RENT
  ASSET_RECEIVABLE_UTILITY
  LIABILITY_SECURITY_DEPOSIT
  LIABILITY_VENDOR_PAYABLE
  LIABILITY_TAX_COLLECTED
  REVENUE_RENTAL_INCOME
  REVENUE_LATE_FEES
  REVENUE_CAM_CHARGES
  REVENUE_CONVENIENCE_FEES
  EXPENSE_MAINTENANCE
  EXPENSE_UTILITIES
  EXPENSE_PLATFORM_FEE
  EXPENSE_COMMISSION
  EQUITY_OWNER_CAPITAL
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum TicketStatus {
  REPORTED
  TRIAGED
  ASSIGNED
  QUOTE_REQUESTED
  QUOTE_APPROVED
  WORK_IN_PROGRESS
  VERIFICATION_PENDING
  RESOLVED
  CLOSED
  CANCELLED
}

enum DocumentCategory {
  LEASE_AGREEMENT
  TITLE_DEED
  TAX_RECEIPT
  GOVERNMENT_ID
  POLICE_VERIFICATION
  INSPECTION_REPORT
  UTILITY_BILL
  MAINTENANCE_INVOICE
  PAYMENT_RECEIPT
  ESTATE_INVENTORY
}

enum DocumentAccessLevel {
  PUBLIC
  ORGANIZATION_INTERNAL
  CONFIDENTIAL_OWNER_ONLY
  PRIVATE_TENANT_SPECIFIC
  SYSTEM_RESTRICTED
}

enum SubscriptionBillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  UNPAID
  CANCELLED
  EXPIRED
}

// ============================================================================
// MODULE 1: ORGANIZATION & MEMBERSHIP
// ============================================================================

model User {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String                  @unique @db.VarChar(255)
  passwordHash         String                  @map("password_hash") @db.VarChar(255)
  fullName             String                  @map("full_name") @db.VarChar(150)
  phone                String?                 @db.VarChar(30)
  avatarUrl            String?                 @map("avatar_url") @db.Text
  globalRole           GlobalRole              @default(USER) @map("global_role")
  isActive             Boolean                 @default(true) @map("is_active")
  twoFactorEnabled     Boolean                 @default(false) @map("two_factor_enabled")
  twoFactorSecret      String?                 @map("two_factor_secret") @db.VarChar(128)
  failedLoginAttempts  Int                     @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime?               @map("locked_until") @db.Timestamptz(6)
  lastLoginAt          DateTime?               @map("last_login_at") @db.Timestamptz(6)
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships          OrganizationMembership[]
  ownedOrganizations   Organization[]          @relation("OrgOwner")
  resourceGrants       ResourceAccessGrant[]
  sessions             UserSession[]
  passwordResetTokens  PasswordResetToken[]
  auditEvents          AuditEvent[]            @relation("ActorAuditEvents")
  leasesSigned         LeaseParty[]
  reportedTickets      WorkOrder[]             @relation("TicketReporter")
  assignedTasks        WorkOrder[]             @relation("TicketAssignee")
  documentAuditLogs    DocumentAccessLog[]
  subscriptionsOwned   Subscription[]
  notifications        Notification[]
  leadsAssigned        Lead[]                  @relation("LeadAssignee")
  applicationsReviewed Application[]           @relation("ApplicationReviewer")
  visitsConducted      Visit[]                 @relation("VisitAgent")
  approvalsGiven       Approval[]              @relation("ApprovalUser")
  assignedWorkOrders   VendorAssignment[]      @relation("VendorAssignee")

  @@index([email])
  @@index([phone])
  @@map("users")
}

model UserSession {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  sessionToken String    @unique @map("session_token") @db.VarChar(255)
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  userAgent    String?   @map("user_agent") @db.Text
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
  @@map("user_sessions")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model Organization {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String                   @db.VarChar(200)
  slug                String                   @unique @db.VarChar(100)
  legalEntityName     String?                  @map("legal_entity_name") @db.VarChar(255)
  taxIdentifier       String?                  @map("tax_identifier") @db.VarChar(50)
  ownerId             String                   @map("owner_id") @db.Uuid
  billingEmail        String?                  @map("billing_email") @db.VarChar(255)
  currency            String                   @default("INR") @db.VarChar(3)
  country             String                   @default("IND") @db.VarChar(3)
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner               User                     @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  memberships         OrganizationMembership[]
  invitations         OrganizationInvitation[]
  portfolios          Portfolio[]
  properties          Property[]
  accounts            Account[]
  journalEntries      JournalEntry[]
  subscriptions       Subscription[]
  auditEvents         AuditEvent[]
  vendors             Vendor[]
  scheduledTasks      ScheduledTask[]
  notifications       Notification[]
  leads               Lead[]

  @@index([slug])
  @@index([ownerId])
  @@map("organizations")
}

model OrganizationMembership {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  userId         String                @map("user_id") @db.Uuid
  role           OrgRole               @default(TENANT)
  isDefault      Boolean               @default(false) @map("is_default")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRoles    MembershipRole[]
  resourceGrants ResourceAccessGrant[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_memberships")
}

model OrganizationInvitation {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String    @db.VarChar(255)
  role           OrgRole   @default(FIELD_STAFF)
  tokenHash      String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

// ============================================================================
// MODULE 2: ACCESS CONTROL & PERMISSIONS
// ============================================================================

model Role {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String           @unique @db.VarChar(50)
  description    String?          @db.Text
  isSystem       Boolean          @default(false) @map("is_system")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  permissions    RolePermission[]
  memberships    MembershipRole[]

  @@map("roles")
}

model RolePermission {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId     String     @map("role_id") @db.Uuid
  permission Permission

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@map("role_permissions")
}

model MembershipRole {
  membershipId String                 @map("membership_id") @db.Uuid
  roleId       String                 @map("role_id") @db.Uuid

  membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role                   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@map("membership_roles")
}

model ResourceAccessGrant {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  membershipId   String                 @map("membership_id") @db.Uuid
  userId         String                 @map("user_id") @db.Uuid
  resourceType   String                 @map("resource_type") @db.VarChar(50)
  resourceId     String                 @map("resource_id") @db.Uuid
  canRead        Boolean                @default(true) @map("can_read")
  canWrite       Boolean                @default(false) @map("can_write")
  canDelete      Boolean                @default(false) @map("can_delete")
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  membership     OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([membershipId, resourceType, resourceId])
  @@index([userId, resourceType, resourceId])
  @@map("resource_access_grants")
}

// ============================================================================
// MODULE 3: PROPERTY STRUCTURE (PORTFOLIOS, BUILDINGS, FLOORS, UNITS, ROOMS, BEDS, ASSETS)
// ============================================================================

model Portfolio {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  name           String        @db.VarChar(150)
  description    String?       @db.Text
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  properties     Property[]

  @@index([organizationId])
  @@map("portfolios")
}

model Property {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String             @map("organization_id") @db.Uuid
  portfolioId        String?            @map("portfolio_id") @db.Uuid
  name               String             @db.VarChar(200)
  propertyType       PropertyType       @map("property_type")
  addressStreet      String             @map("address_street") @db.Text
  city               String             @db.VarChar(100)
  state              String             @db.VarChar(100)
  pincode            String             @db.VarChar(20)
  latitude           Decimal?           @db.Decimal(10, 8)
  longitude          Decimal?           @db.Decimal(11, 8)
  status             PropertyStatus     @default(ACTIVE)
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?          @map("verified_at") @db.Timestamptz(6)
  verifiedBy         String?            @map("verified_by") @db.Uuid
  heroImageUrl       String?            @map("hero_image_url") @db.Text
  totalAreaSqFt      Decimal?           @map("total_area_sq_ft") @db.Decimal(12, 2)
  amenities          Json               @default("[]")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  portfolio          Portfolio?         @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
  buildings          Building[]
  units              PropertyUnit[]
  assets             Asset[]
  documents          Document[]
  workOrders         WorkOrder[]
  invoices           Invoice[]
  meterReadings      MeterReading[]
  utilityBills       UtilityBill[]
  visits             Visit[]
  applications       Application[]
  scheduledTasks     ScheduledTask[]

  @@index([organizationId])
  @@index([portfolioId])
  @@index([verificationStatus])
  @@map("properties")
}

model Building {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId  String         @map("property_id") @db.Uuid
  name        String         @db.VarChar(100) // "Tower A", "Block 1", "Main Villa"
  totalFloors Int            @default(1) @map("total_floors")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  property    Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  floors      Floor[]
  units       PropertyUnit[]

  @@unique([propertyId, name])
  @@index([propertyId])
  @@map("buildings")
}

model Floor {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buildingId  String         @map("building_id") @db.Uuid
  floorNumber Int            @map("floor_number")
  floorLabel  String         @map("floor_label") @db.VarChar(50) // "3rd Floor", "Ground Floor", "Mezzanine"
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  building    Building       @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  units       PropertyUnit[]

  @@unique([buildingId, floorNumber])
  @@index([buildingId])
  @@map("floors")
}

model PropertyUnit {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId     String              @map("property_id") @db.Uuid
  buildingId     String?             @map("building_id") @db.Uuid
  floorId        String?             @map("floor_id") @db.Uuid
  unitNumber     String              @map("unit_number") @db.VarChar(50)
  unitType       String              @default("1BHK") @map("unit_type") @db.VarChar(50)
  status         UnitStatus          @default(VACANT)
  marketRent     Decimal             @map("market_rent") @db.Decimal(12, 2)
  depositRequired Decimal            @map("deposit_required") @db.Decimal(12, 2)
  areaSqFt       Decimal?            @map("area_sq_ft") @db.Decimal(10, 2)
  bedrooms       Int                 @default(1)
  bathrooms      Int                 @default(1)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  property       Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  building       Building?           @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  floor          Floor?              @relation(fields: [floorId], references: [id], onDelete: SetNull)
  rooms          Room[]
  assets         Asset[]
  tenancies      Tenancy[]
  meterReadings  MeterReading[]
  utilityBills   UtilityBill[]
  workOrders     WorkOrder[]
  applications   Application[]
  occupancies    OccupancyHistory[]

  @@unique([propertyId, unitNumber])
  @@index([propertyId])
  @@index([buildingId])
  @@index([floorId])
  @@index([status])
  @@map("units")
}

model Room {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unitId      String       @map("unit_id") @db.Uuid
  roomNumber  String       @map("room_number") @db.VarChar(50) // "Room 101", "Master Bedroom"
  roomType    String       @default("PRIVATE") @map("room_type") @db.VarChar(50)
  status      UnitStatus   @default(VACANT)
  monthlyRent Decimal      @map("monthly_rent") @db.Decimal(12, 2)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  unit        PropertyUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  beds        Bed[]
  assets      Asset[]

  @@unique([unitId, roomNumber])
  @@index([unitId])
  @@map("rooms")
}

model Bed {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId      String       @map("room_id") @db.Uuid
  bedCode     String       @map("bed_code") @db.VarChar(50) // "Bed A", "Lower Bunk 1"
  status      UnitStatus   @default(VACANT)
  monthlyRent Decimal      @map("monthly_rent") @db.Decimal(12, 2)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  room        Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tenancies   Tenancy[]

  @@unique([roomId, bedCode])
  @@index([roomId])
  @@map("beds")
}

model Asset {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId     String       @map("property_id") @db.Uuid
  unitId         String?      @map("unit_id") @db.Uuid
  roomId         String?      @map("room_id") @db.Uuid
  assetTag       String       @unique @map("asset_tag") @db.VarChar(100)
  category       String       @db.VarChar(100) // "APPLIANCE", "FURNITURE", "HVAC", "GENERATOR"
  brand          String?      @db.VarChar(100)
  modelNumber    String?      @map("model_number") @db.VarChar(100)
  serialNumber   String?      @map("serial_number") @db.VarChar(100)
  purchaseDate   DateTime?    @map("purchase_date") @db.Date
  warrantyUntil  DateTime?    @map("warranty_until") @db.Date
  condition      String       @default("EXCELLENT") @db.VarChar(50)
  amcProvider    String?      @map("amc_provider") @db.VarChar(150)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit           PropertyUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  room           Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([unitId])
  @@map("assets")
}

// ============================================================================
// MODULE 4: OCCUPANCY (TENANCIES, LEASE PARTIES, OCCUPANCY HISTORY)
// ============================================================================

model Tenancy {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unitId             String             @map("unit_id") @db.Uuid
  bedId              String?            @map("bed_id") @db.Uuid
  leaseNumber        String             @unique @map("lease_number") @db.VarChar(50)
  status             LeaseStatus        @default(ACTIVE)
  startDate          DateTime           @map("start_date") @db.Date
  endDate            DateTime           @map("end_date") @db.Date
  monthlyRent        Decimal            @map("monthly_rent") @db.Decimal(12, 2)
  depositRequired    Decimal            @map("deposit_required") @db.Decimal(12, 2)
  depositReceived    Decimal            @default(0) @map("deposit_received") @db.Decimal(12, 2)
  rentDueDayOfMonth  Int                @default(5) @map("rent_due_day_of_month")
  gracePeriodDays    Int                @default(3) @map("grace_period_days")
  lateFeeFlat        Decimal            @default(0) @map("late_fee_flat") @db.Decimal(12, 2)
  autopayEnabled     Boolean            @default(false) @map("autopay_enabled")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
