}

model DepositSettlement {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  securityDepositId  String          @map("security_deposit_id") @db.Uuid
  originalDeposit    Decimal         @map("original_deposit") @db.Decimal(12, 2)
  approvedDeductions Decimal         @map("approved_deductions") @db.Decimal(12, 2)
  netRefundPayable   Decimal         @map("net_refund_payable") @db.Decimal(12, 2)
  bankTransactionRef String?         @map("bank_transaction_ref") @db.VarChar(100)
  signedOffByTenant  Boolean         @default(false) @map("signed_off_by_tenant")
  settledAt          DateTime        @default(now()) @map("settled_at") @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  securityDeposit    SecurityDeposit @relation(fields: [securityDepositId], references: [id], onDelete: Cascade)

  @@index([securityDepositId])
  @@map("deposit_settlements")
}

model DepositDispute {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  securityDepositId String          @map("security_deposit_id") @db.Uuid
  disputedAmount    Decimal         @map("disputed_amount") @db.Decimal(12, 2)
  tenantClaimReason String          @map("tenant_claim_reason") @db.Text
  ownerResponse     String?         @map("owner_response") @db.Text
  resolutionStatus  String          @default("OPEN") @map("resolution_status") @db.VarChar(50)
  settledAmount     Decimal?        @map("settled_amount") @db.Decimal(12, 2)
  settledAt         DateTime?       @map("settled_at") @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  securityDeposit   SecurityDeposit @relation(fields: [securityDepositId], references: [id], onDelete: Cascade)

  @@index([securityDepositId])
  @@map("disputes")
}

