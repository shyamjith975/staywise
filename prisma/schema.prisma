  propertyId         String       @map("property_id") @db.Uuid
  unitId             String?      @map("unit_id") @db.Uuid
  leadId             String?      @map("lead_id") @db.Uuid
  reviewedById       String?      @map("reviewed_by_id") @db.Uuid
  applicantName      String       @map("applicant_name") @db.VarChar(150)
  applicantEmail     String       @map("applicant_email") @db.VarChar(255)
  applicantPhone     String       @map("applicant_phone") @db.VarChar(30)
  annualIncome       Decimal?     @map("annual_income") @db.Decimal(12, 2)
  creditScore        Int?         @map("credit_score")
  status             String       @default("SUBMITTED") @db.VarChar(50) // "SUBMITTED", "UNDER_REVIEW", "APPROVED", "REJECTED"
