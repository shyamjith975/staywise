// MODULE 7: ACCOUNTING (ACCOUNTS, JOURNAL ENTRIES, LINES, SETTLEMENTS, REFUNDS)
// ============================================================================

model Account {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  accountNumber  String          @map("account_number") @db.VarChar(50)
  name           String          @db.VarChar(150)
  category       AccountCategory
  currency       String          @default("INR") @db.VarChar(3)
  isLocked       Boolean         @default(false) @map("is_locked")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journalLines   JournalLine[]

  @@unique([organizationId, accountNumber])
  @@index([organizationId])
  @@index([category])
  @@map("accounts")
}

model JournalEntry {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  entryNumber     String        @unique @map("entry_number") @db.VarChar(50)
  paymentId       String?       @map("payment_id") @db.Uuid
  description     String        @db.Text
  postingDate     DateTime      @default(now()) @map("posting_date") @db.Date
  isReversed      Boolean       @default(false) @map("is_reversed")
  reversalOfId    String?       @unique @map("reversal_of_id") @db.Uuid
  tamperProofHash String        @map("tamper_proof_hash") @db.VarChar(64)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment         Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  reversalOf      JournalEntry? @relation("ReversalRel", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy      JournalEntry? @relation("ReversalRel")
  lines           JournalLine[]

  @@index([organizationId])
  @@index([postingDate])
  @@map("journal_entries")
}

model JournalLine {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  journalEntryId String          @map("journal_entry_id") @db.Uuid
  accountId      String          @map("account_id") @db.Uuid
  entryType      LedgerEntryType @map("entry_type")
  amount         Decimal         @db.Decimal(12, 2)
  memo           String?         @db.VarChar(255)

  journalEntry   JournalEntry    @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}

model Settlement {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId            String?   @map("payment_id") @db.Uuid
  settlementReference  String    @unique @map("settlement_reference") @db.VarChar(100)
  beneficiaryAccount   String    @map("beneficiary_account") @db.VarChar(50)
  amountGross          Decimal   @map("amount_gross") @db.Decimal(12, 2)
  feePlatform          Decimal   @default(0) @map("fee_platform") @db.Decimal(12, 2)
  amountNet            Decimal   @map("amount_net") @db.Decimal(12, 2)
  status               String    @default("PROCESSED") @db.VarChar(50) // "PENDING", "PROCESSED", "RECONCILED", "FAILED"
  utrNumber            String?   @map("utr_number") @db.VarChar(100)
  settledAt            DateTime  @default(now()) @map("settled_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  payment              Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([settlementReference])
  @@index([status])
  @@map("settlements")
}

model Refund {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId        String        @map("payment_id") @db.Uuid
  refundReference  String        @unique @map("refund_reference") @db.VarChar(100)
  amount           Decimal       @db.Decimal(12, 2)
  reason           String        @db.Text
  status           PaymentStatus @default(PROCESSING)
  processedAt      DateTime?     @map("processed_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  payment          Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([refundReference])
  @@map("refunds")
}

