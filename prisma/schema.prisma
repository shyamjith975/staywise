  property        Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit            PropertyUnit?      @relation(fields: [unitId], references: [id], onDelete: SetNull)
  vendor          Vendor?            @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  reporter        User               @relation("TicketReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  assignee        User?              @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  quotes          Quote[]
  assignments     VendorAssignment[]
  approvals       Approval[]
  evidence        ServiceEvidence[]

  @@index([propertyId])
  @@index([vendorId])
  @@index([status])
  @@map("work_orders")
}

model Quote {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workOrderId String    @map("work_order_id") @db.Uuid
  vendorId    String    @map("vendor_id") @db.Uuid
  quoteNumber String    @map("quote_number") @db.VarChar(50)
  laborCost   Decimal   @map("labor_cost") @db.Decimal(12, 2)
  partsCost   Decimal   @default(0) @map("parts_cost") @db.Decimal(12, 2)
  totalCost   Decimal   @map("total_cost") @db.Decimal(12, 2)
  isApproved  Boolean   @default(false) @map("is_approved")
  validUntil  DateTime? @map("valid_until") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  vendor      Vendor    @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@index([workOrderId])
  @@index([vendorId])
  @@map("quotes")
}

model VendorAssignment {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workOrderId    String    @map("work_order_id") @db.Uuid
  vendorId       String    @map("vendor_id") @db.Uuid
  technicianId   String?   @map("technician_id") @db.Uuid
  scheduledStart DateTime  @map("scheduled_start") @db.Timestamptz(6)
  scheduledEnd   DateTime? @map("scheduled_end") @db.Timestamptz(6)
  status         String    @default("ASSIGNED") @db.VarChar(50)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  workOrder      WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  vendor         Vendor    @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  technician     User?     @relation("VendorAssignee", fields: [technicianId], references: [id], onDelete: SetNull)

  @@index([workOrderId])
  @@index([vendorId])
  @@map("vendor_assignments")
}

model Approval {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workOrderId String    @map("work_order_id") @db.Uuid
  approverId  String    @map("approver_id") @db.Uuid
  approvalType String   @map("approval_type") @db.VarChar(50) // "QUOTE_APPROVAL", "COMPLETION_SIGN_OFF"
  isApproved  Boolean   @default(true) @map("is_approved")
  amountLimit Decimal?  @map("amount_limit") @db.Decimal(12, 2)
  comments    String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  approver    User      @relation("ApprovalUser", fields: [approverId], references: [id], onDelete: Restrict)

  @@index([workOrderId])
  @@map("approvals")
}

model ServiceEvidence {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workOrderId  String    @map("work_order_id") @db.Uuid
  evidenceType String    @map("evidence_type") @db.VarChar(50) // "BEFORE_PHOTO", "AFTER_PHOTO", "PARTS_INVOICE", "COMPLETION_SIGNATURE"
  fileUrl      String    @map("file_url") @db.Text
  caption      String?   @db.VarChar(255)
  recordedAt   DateTime  @default(now()) @map("recorded_at") @db.Timestamptz(6)

  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@map("service_evidence")
}

// ============================================================================
// MODULE 10: FILES & DOCUMENTS (DOCUMENTS, VERSIONS, ACCESS LOGS)
// ============================================================================

model Document {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId      String?              @map("property_id") @db.Uuid
  uploaderId      String               @map("uploader_id") @db.Uuid
  fileName        String               @map("file_name") @db.VarChar(255)
  category        DocumentCategory
  accessLevel     DocumentAccessLevel  @default(CONFIDENTIAL_OWNER_ONLY) @map("access_level")
  mimeType        String               @map("mime_type") @db.VarChar(100)
  fileSizeBytes   Int                  @map("file_size_bytes")
  storagePath     String               @map("storage_path") @db.Text
  sha256Checksum  String               @map("sha256_checksum") @db.VarChar(64)
  currentVersion  Int                  @default(1) @map("current_version")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  property        Property?            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  versions        DocumentVersion[]
  accessLogs      DocumentAccessLog[]

  @@index([propertyId])
  @@index([category])
  @@index([sha256Checksum])
  @@map("documents")
}

model DocumentVersion {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId    String    @map("document_id") @db.Uuid
  versionNumber Int       @map("version_number")
  storagePath   String    @map("storage_path") @db.Text
  fileSizeBytes Int       @map("file_size_bytes")
  sha256Hash    String    @map("sha256_hash") @db.VarChar(64)
  changeSummary String?   @map("change_summary") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@map("document_versions")
}

model DocumentAccessLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  action     String   @db.VarChar(50) // "SIGNED_URL_ISSUED", "VIEWED", "DOWNLOADED"
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([documentId])
  @@index([userId])
  @@map("document_access_logs")
}

// ============================================================================
// MODULE 11: OPERATIONS (METER READINGS, UTILITY BILLS, INSPECTIONS, SCHEDULED TASKS)
// ============================================================================

model MeterReading {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId      String        @map("property_id") @db.Uuid
  unitId          String?       @map("unit_id") @db.Uuid
  meterType       String        @map("meter_type") @db.VarChar(50) // "ELECTRICITY", "WATER", "GAS"
  meterNumber     String        @map("meter_number") @db.VarChar(100)
  previousReading Decimal       @map("previous_reading") @db.Decimal(12, 2)
  currentReading  Decimal       @map("current_reading") @db.Decimal(12, 2)
  unitsConsumed   Decimal       @map("units_consumed") @db.Decimal(12, 2)
  readingDate     DateTime      @map("reading_date") @db.Date
  photoProofUrl   String?       @map("photo_proof_url") @db.Text
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  property        Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit            PropertyUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([meterNumber])
  @@map("meter_readings")
}

model UtilityBill {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId   String        @map("property_id") @db.Uuid
  unitId       String?       @map("unit_id") @db.Uuid
  discomName   String        @map("discom_name") @db.VarChar(150)
  billNumber   String        @map("bill_number") @db.VarChar(100)
  billingMonth String        @map("billing_month") @db.VarChar(20)
  totalAmount  Decimal       @map("total_amount") @db.Decimal(12, 2)
  dueDate      DateTime      @map("due_date") @db.Date
  status       String        @default("PENDING") @db.VarChar(50)
  documentUrl  String?       @map("document_url") @db.Text
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit         PropertyUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@map("utility_bills")
}

model Inspection {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenancyId       String    @map("tenancy_id") @db.Uuid
  inspectionType  String    @map("inspection_type") @db.VarChar(20) // "MOVE_IN", "ROUTINE", "MOVE_OUT"
  conductedAt     DateTime  @default(now()) @map("conducted_at") @db.Timestamptz(6)
  inspectorName   String    @map("inspector_name") @db.VarChar(150)
  overallRating   Int       @default(5) @map("overall_rating")
  checklistJson   Json      @map("checklist_json")
  tenantSignature String?   @map("tenant_signature") @db.Text
  signedAt        DateTime? @map("signed_at") @db.Timestamptz(6)

  tenancy         Tenancy   @relation(fields: [tenancyId], references: [id], onDelete: Cascade)

  @@index([tenancyId])
  @@map("inspections")
}

model ScheduledTask {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  propertyId     String?      @map("property_id") @db.Uuid
  taskName       String       @map("task_name") @db.VarChar(150)
  cronSchedule   String       @map("cron_schedule") @db.VarChar(50) // "0 0 1 * *"
  handlerType    String       @map("handler_type") @db.VarChar(100) // "GENERATE_RENT_INVOICES", "SEND_LATE_FEE_REMINDERS", "AMC_INSPECTION_CHECK"
  isActive       Boolean      @default(true) @map("is_active")
  lastRunAt      DateTime?    @map("last_run_at") @db.Timestamptz(6)
  nextRunAt      DateTime?    @map("next_run_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property       Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([handlerType])
  @@map("scheduled_tasks")
}

// ============================================================================
// MODULE 12: PLATFORM (SUBSCRIPTIONS, PLANS, WEBHOOKS, NOTIFICATIONS, AUDIT LOGS)
// ============================================================================

model SubscriptionPlan {
  id               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String                    @unique @db.VarChar(50)
  name             String                    @db.VarChar(100)
  description      String?                   @db.Text
  monthlyPrice     Decimal                   @map("monthly_price") @db.Decimal(12, 2)
  annualPrice      Decimal                   @map("annual_price") @db.Decimal(12, 2)
  maxUnitsIncluded Int                       @map("max_units_included")
  extraUnitRate    Decimal                   @default(0) @map("extra_unit_rate") @db.Decimal(10, 2)
  featuresJson     Json                      @map("features_json")
  isActive         Boolean                   @default(true) @map("is_active")
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  subscriptions    Subscription[]

  @@map("plans")
}

model Subscription {
  id                   String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String                    @map("organization_id") @db.Uuid
  planId               String                    @map("plan_id") @db.Uuid
  ownerId              String                    @map("owner_id") @db.Uuid
  status               SubscriptionStatus        @default(TRIALING)
  billingCycle         SubscriptionBillingCycle  @default(MONTHLY) @map("billing_cycle")
  currentPeriodStart   DateTime                  @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd     DateTime                  @map("current_period_end") @db.Timestamptz(6)
  trialEndsAt          DateTime?                 @map("trial_ends_at") @db.Timestamptz(6)
  cancelledAt          DateTime?                 @map("cancelled_at") @db.Timestamptz(6)
  maxAllowedUnits      Int                       @map("max_allowed_units")
  activeUnitsCount     Int                       @default(0) @map("active_units_count")
  tamperProofHash      String                    @map("tamper_proof_hash") @db.VarChar(64)
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                 SubscriptionPlan          @relation(fields: [planId], references: [id], onDelete: Restrict)
  owner                User                      @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

model WebhookEvent {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gatewayProvider String    @map("gateway_provider") @db.VarChar(50)
  eventId         String    @unique @map("event_id") @db.VarChar(150)
  eventType       String    @map("event_type") @db.VarChar(100)
  signature       String    @db.VarChar(255)
  payloadJson     Json      @map("payload_json")
  isProcessed     Boolean   @default(false) @map("is_processed")
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(6)
  errorMessage    String?   @map("error_message") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([eventId])
  @@index([isProcessed])
  @@map("webhook_events")
}

model Notification {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  title          String        @db.VarChar(200)
  message        String        @db.Text
  category       String        @db.VarChar(50) // "RENT_DUE", "TICKET_UPDATE", "LEASE_EXPIRY", "SYSTEM_ALERT"
  channel        String        @default("IN_APP") @db.VarChar(50) // "IN_APP", "SMS", "WHATSAPP", "EMAIL"
  isRead         Boolean       @default(false) @map("is_read")
  readAt         DateTime?     @map("read_at") @db.Timestamptz(6)
  actionUrl      String?       @map("action_url") @db.Text
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model AuditEvent {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  actorId        String?       @map("actor_id") @db.Uuid
  actionType     String        @map("action_type") @db.VarChar(100)
  resourceType   String        @map("resource_type") @db.VarChar(50)
  resourceId     String        @map("resource_id") @db.VarChar(100)
  previousState  Json?         @map("previous_state")
  newState       Json?         @map("new_state")
  ipAddress      String?       @map("ip_address") @db.VarChar(45)
  userAgent      String?       @map("user_agent") @db.Text
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          User?         @relation("ActorAuditEvents", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([actorId])
  @@index([actionType])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}
