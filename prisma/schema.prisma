  agent          User?     @relation("VisitAgent", fields: [agentId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([leadId])
  @@map("visits")
}

model LeaseDocument {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenancyId      String    @map("tenancy_id") @db.Uuid
  title          String    @db.VarChar(200)
